# CivicFix Environment Configuration Template
# Copy this file to .env and configure for your local environment

# SMTP Email Configuration (for OTP verification)
CIVICFIX_EMAIL=your_email@gmail.com
CIVICFIX_APP_PASSWORD=your_google_app_password

# Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=civicfix_app
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=civicfix_friendcopy

# Flask Configuration
FLASK_SECRET_KEY=your_secret_key_here
FLASK_DEBUG=True

# MongoDB Photo Storage Configuration
MONGO_URI=mongodb://127.0.0.1:27017/
MONGO_DB_NAME=civicfix_photos
